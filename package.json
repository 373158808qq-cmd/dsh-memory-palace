{
  "name": "dsh-memory-palace",
  "version": "0.11.3",
  "description": "懂你记忆系统：每轮注入画像/长期记忆/协作规矩 + 台账纪律 + 本地语义检索 + 会话转写 + 一键初始化 + 设置页维护作业。",
  "type": "module",
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "author": "373158808qq-cmd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/373158808qq-cmd/dsh-memory-palace.git"
  },
  "homepage": "https://github.com/373158808qq-cmd/dsh-memory-palace#readme",
  "bugs": {
    "url": "https://github.com/373158808qq-cmd/dsh-memory-palace/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "long-term-memory",
    "agent-memory",
    "semantic-search",
    "rag",
    "ollama",
    "obsidian",
    "ledger"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
